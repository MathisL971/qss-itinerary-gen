# =============================================================================
# QSS Itinerary Generator - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key
# Found in: Supabase Dashboard > Settings > API > Project API keys > anon public
# Note: This key is safe to expose in the frontend - RLS protects your data
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Site Configuration (Optional)
# -----------------------------------------------------------------------------
# The URL where your app is hosted
# Used for email redirects and share links
# Defaults to window.location.origin if not set
VITE_SITE_URL=http://localhost:5173

# =============================================================================
# Security Notes
# =============================================================================
# 1. VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are exposed in the browser.
#    This is safe because Row Level Security (RLS) protects your data.
#
# 2. Never expose your SUPABASE_SERVICE_ROLE_KEY in frontend code!
#    That key bypasses RLS and should only be used in secure server environments.
#
# 3. For production deployments, configure environment variables in your
#    hosting platform (Vercel, Netlify, etc.) rather than using .env files.
# =============================================================================
